# Copy to .env.prod (gitignored — never commit the real file) and fill
# in real values. Used by docker-compose.prod.yml via `env_file:`.

# The domain Caddy requests a Let's Encrypt certificate for, and that
# gets baked into the frontend's build (see docker-compose.prod.yml).
DODA_DOMAIN=natsecurity.uz

DODA_ENV=production

# Real password for the Postgres bootstrap role (docker-compose.prod.yml
# passes this to the postgres image's POSTGRES_PASSWORD). Generate one,
# e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Service names (not localhost) because these run inside the compose
# network. doda_app has no configurable password here — infra/postgres-
# init/01-create-app-role.sql hardcodes it for local dev; change that
# script's literal alongside this value for a real deployment.
DODA_DATABASE_URL=postgresql+asyncpg://doda_app:doda_app@postgres:5432/doda
DODA_MIGRATION_DATABASE_URL=postgresql+asyncpg://doda:change-me@postgres:5432/doda
DODA_REDIS_URL=redis://redis:6379/0

# object_storage_* settings are left at their config.py defaults —
# unused by any code path today (Knowledge/RAG, the domain that would
# read them, doesn't exist yet). docker-compose.prod.yml deliberately
# has no object-storage/minio service for the same reason: standing up
# storage infra for a feature that isn't built would be speculative.

# Must be the public origin — same as DODA_DOMAIN above, over https.
DODA_CORS_ALLOWED_ORIGINS=https://natsecurity.uz
DODA_FRONTEND_BASE_URL=https://natsecurity.uz
# Must include the /v1 prefix api/auth.py's router actually uses
# (APIRouter(prefix="/v1/auth")) — deploy/Caddyfile only routes /v1/*
# to the backend, so a redirect URI without it would land on the
# frontend (which has no such route) and 404 instead of completing login.
DODA_GOOGLE_OAUTH_REDIRECT_URI=https://natsecurity.uz/v1/auth/google/callback

# From Google Cloud Console (OAuth 2.0 Client). Client ID is not
# sensitive; the secret is — treat this whole file as sensitive anyway,
# since it also carries the Postgres password above.
DODA_GOOGLE_OAUTH_CLIENT_ID=
DODA_GOOGLE_OAUTH_CLIENT_SECRET=

# Optional — omit to run without the Telegram connector.
DODA_TELEGRAM_BOT_TOKEN=
