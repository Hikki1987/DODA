DODA_ENV=local
# Runtime app connection — the unprivileged doda_app role (ADR-005: must
# never be a Postgres superuser, or FORCE ROW LEVEL SECURITY is a no-op).
DODA_DATABASE_URL=postgresql+asyncpg://doda_app:doda_app@localhost:5432/doda
# Alembic only — needs superuser to CREATE EXTENSION vector/pgcrypto.
DODA_MIGRATION_DATABASE_URL=postgresql+asyncpg://doda:doda@localhost:5432/doda
DODA_REDIS_URL=redis://localhost:6379/0
DODA_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
DODA_OBJECT_STORAGE_BUCKET=doda-files
