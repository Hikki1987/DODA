DODA_ENV=local
# Runtime app connection — the unprivileged doda_app role (ADR-005: must
# never be a Postgres superuser, or FORCE ROW LEVEL SECURITY is a no-op).
DODA_DATABASE_URL=postgresql+asyncpg://doda_app:doda_app@localhost:5432/doda
# Alembic only — needs superuser to CREATE EXTENSION vector/pgcrypto.
DODA_MIGRATION_DATABASE_URL=postgresql+asyncpg://doda:doda@localhost:5432/doda
DODA_REDIS_URL=redis://localhost:6379/0
# OD-002 first connector. Optional — omit entirely if you aren't running the
# Telegram relay (infrastructure/telegram_relay.py). Never commit a real
# value; this file is a template, not where the real token lives.
# DODA_TELEGRAM_BOT_TOKEN=123456:your-bot-token-here
# FR-AUTH-001 real Google OIDC login. Optional — omit entirely to keep
# using the dev/test session-ID form on /login. Never commit real values;
# this file is a template, not where the real credentials live.
# DODA_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# DODA_GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# Must exactly match an "Authorized redirect URI" on the Google OAuth client.
# DODA_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
# Where /v1/auth/google/callback hands the browser off to after login.
# DODA_FRONTEND_BASE_URL=http://localhost:3000
DODA_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
DODA_OBJECT_STORAGE_BUCKET=doda-files
# Origin(s) the web frontend is served from — comma-separated, never "*".
DODA_CORS_ALLOWED_ORIGINS=http://localhost:3000
